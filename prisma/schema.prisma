generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Psychomotricien {
  id           String   @id @default(cuid())
  fullName     String
  email        String?  @unique
  passwordHash String?
  specialty    String
  city         String
  governorate  String
  phone        String
  exactAddress String
  isPublished  Boolean  @default(false)
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())

  @@index([isPublished, governorate, city])
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String?
  type          String
  date          DateTime
  startTime     String
  endTime       String
  locationName  String
  lat           Float?
  lng           Float?
  capacity      Int
  audience      String
  status        String              @default("DRAFT")
  createdAt     DateTime            @default(now())
  registrations EventRegistration[]

  @@index([status, date])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  fullName  String
  email     String
  phone     String
  specialty String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([eventId, status, createdAt])
}

model AdhesionRequest {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String
  professionalStatus String
  message            String
  diplomaFile        String?
  patenteFile        String?
  rneFile            String?
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, createdAt])
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([isPublished, publishedAt])
}

model TeamMember {
  id          String   @id @default(cuid())
  fullName    String
  role        String
  biography   String?
  image       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  isAlumni    Boolean  @default(false)
  yearsActive String?
  createdAt   DateTime @default(now())
}

model InternshipRequest {
  id               String   @id @default(cuid())
  fullName         String
  email            String
  country          String
  university       String
  level            String
  cvUrl            String?
  motivationLetter String
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}

model Milestone {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(cuid())
  imageUrl    String
  altText     String
  caption     String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}
